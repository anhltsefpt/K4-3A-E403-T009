# Copy file này thành `.env` và điền giá trị thật. KHÔNG commit `.env`.
OPENAI_API_KEY=sk-...
# Chỉ cần cho bot Discord live (bot.py). Lấy ở Developer Portal → Bot → Reset Token.
DISCORD_BOT_TOKEN=
# ID server test (chuột phải tên server → Copy Server ID, cần bật Developer Mode).
# Có GUILD_ID → /digest hiện NGAY; để trống → sync global, chờ tới ~1h.
GUILD_ID=
